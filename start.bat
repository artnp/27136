@echo off
chcp 65001 >nul
title Garden Plan Server - ระบบจัดการแปลนต้นไม้
cd /d "%~dp0"

echo ========================================================
echo    🌱 ระบบจัดการแปลนต้นไม้และสวนในบ้าน (Garden Plan)
echo ========================================================
echo.
echo  กำลังเปิด Web Server และเปิดหน้าเว็บให้คุณอัตโนมัติ...
echo  หากเบราว์เซอร์ไม่เปิดเอง สามารถเข้าได้ที่: http://localhost:8080
echo.
echo  [คำแนะนำ]
echo  - คุณสามารถปักหมุด แก้ไข และลบต้นไม้ผ่านหน้าเว็บได้ทันที
echo  - ข้อมูลจะถูกบันทึกตรงลงไฟล์ data/plants.json อัตโนมัติ
echo  - กด Ctrl+C ในหน้าต่างนี้เมื่อต้องการปิดเซิร์ฟเวอร์
echo ========================================================
echo.

python "%~dp0server.py"

if %ERRORLEVEL% neq 0 (
    echo.
    echo [!] ไม่สามารถรัน Python ได้ กำลังเปิดไฟล์ index.html โดยตรง...
    start "" "%~dp0index.html"
    pause
)
